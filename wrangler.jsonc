{
	// assets-only worker, no script: cloudflare serves build as a static site
	"name": "game2048",
	"compatibility_date": "2026-10-05",
	"assets": {
		"directory": "./build",
		// unknown paths get index.html with 200, the app handles them client side
		"not_found_handling": "single-page-application"
	}
}
