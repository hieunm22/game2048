{
	"compilerOptions": {
		"target": "ES2022",
		"lib": ["ES2022", "DOM", "DOM.Iterable"],
		"module": "ESNext",
		"moduleResolution": "bundler",
		"jsx": "react-jsx",
		"types": ["vite/client", "node"],
		"strict": true,
		"noUnusedLocals": true,
		"noUnusedParameters": true,
		"noFallthroughCasesInSwitch": true,
		"isolatedModules": true,
		"verbatimModuleSyntax": true,
		"skipLibCheck": true,
		"noEmit": true,
		// each root needs both entries: "store/*" alone never matches a bare "store" import
		"paths": {
			"common/*": ["./src/common/*"],
			"components/*": ["./src/components/*"],
			"store": ["./src/store"],
			"store/*": ["./src/store/*"]
		}
	},
	"include": ["src", "vite.config.ts"]
}
